# Copy to PREFIX/share/dume/config.toml (keep it admin-writable only; dume refuses otherwise).

# The tree everyone scans. Absolute path.
root = "/path/to/shared/root"

# Optional.
# threads = 32      # concurrent stats per scan; lower it if many people scan at once
# stale_days = 7    # warn when a user's scan is older than this
# large_file_mb = 1024   # what a recipe's large_file_bytes() returns, in MiB (default 1024)
# rescan_skip_secs = 300  # c skips rescanning a folder refreshed this recently; 0 = always rescan
# Sized but not indexed: browsing cannot enter them and recipes cannot see inside. Applies at the
# next full rescan (r).
# prune = [
#   ".git", ".svn", ".hg",
#   ".venv", "venv", "env", ".direnv", ".conda", "site-packages",
#   "__pycache__", ".mypy_cache", ".pytest_cache", ".ruff_cache", ".tox", ".ipynb_checkpoints", ".cache",
#   "node_modules", "build", "dist", "target",
#   "processor[0-9]*", "dynamicCode",
# ]

# Copy to PREFIX/share/dume/config.toml (keep it admin-writable only; dume refuses otherwise).

# The tree everyone scans. Absolute path.
root = "/path/to/shared/root"

# Optional.
# threads = 32      # concurrent stats per scan; lower it if many people scan at once
# stale_days = 7    # warn when a user's scan is older than this
# rescan_skip_secs = 300  # c skips rescanning a folder refreshed this recently; 0 = always rescan
# prune = [".git", ".venv", ".direnv", "processor[0-9]*", "dynamicCode"]  # sized, not indexed; full rescan to apply
